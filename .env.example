# MML Transaction Hub: environment variables (names only, never real values).
# Copy to .env.local for local development. .env* files must not be committed
# (CI secret scan rejects them). Full reference: docs/configuration.md
# Point local development at the SANDBOX Supabase project, never at live.

# --- Browser (inlined into the client bundle at build time: public values only) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server (never sent to the browser) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret. Server-only admin access; used only in src/integrations/supabase/client.server.ts
SUPABASE_SERVICE_ROLE_KEY=

# Freshdesk (secret API key; server-only, src/lib/freshdesk.server.ts)
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# Optional: defaults in src/lib/app-config.ts / freshdesk-cursor.ts are used when unset
FRESHDESK_GROUP_ID=
FRESHDESK_GROUP_NAME=
FRESHDESK_TICKETS_FROM=
FRESHDESK_FULL_SYNC_HOUR_UTC=
SNAPSHOT_CRON_UTC=

# Feature flag: strict Excel import (SCRUM-103). Anything other than "true" = off.
STRICT_IMPORT_ENABLED=

# AI agents (Phase 1). Server-only. Leave blank unless you are calling a provider.
# Never commit values. The admin UI only learns whether each one is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Local demo only (scripts/demo-local.sh sets this). Do not set in production.
# AI_AGENTS_DEMO=1
